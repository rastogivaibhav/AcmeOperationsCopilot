# LOCAL DEVELOPMENT ONLY. Replace all secrets before using anywhere else.
APP_PORT=8000
# Browser URL used for Keycloak OIDC redirects. Localhost only for the demo.
APP_BASE_URL=http://localhost:8000
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=LocalOnlyChangeThis123!
POSTGRES_USER=acme
POSTGRES_PASSWORD=local-acme-password-change-me
POSTGRES_DB=acme
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=512
# Validated against the local Keycloak realm importer hostname in this demo.
KEYCLOAK_ISSUER=http://localhost:8080/realms/acme
# Browser-facing issuer is localhost; backend uses internal service for JWKS.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/acme/protocol/openid-connect/certs

# Set to console for OpenTelemetry spans with metadata only (no raw prompts or tokens).
OTEL_TRACES_EXPORTER=none
