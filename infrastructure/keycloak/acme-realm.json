      "username": "support-demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jordan",
      "lastName": "Support",
      "email": "support@acme.invalid",
      "realmRoles": [
        "support_user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "SupportLocal2026!",
          "temporary": false
        }
      ]
    },
    {
